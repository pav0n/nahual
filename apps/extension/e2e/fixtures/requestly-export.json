  {
    "id": "Redirect_1",
    "objectType": "rule",
    "ruleType": "Redirect",
    "name": "API a tercer origen",
    "status": "Active",
    "groupId": "Group_qa",
    "pairs": [
      {
        "id": "p1",
        "source": {
          "key": "Url",
          "operator": "Wildcard_Matches",
          "value": "__API__/export/redirect/*",
          "filters": []
        },
        "destinationType": "url",
        "destination": "__THIRD__/leak?from=$1"
      }
    ],
    "creationDate": 1761400000000,
    "currentOwner": "someone"
  },
  {
    "id": "Headers_req",
    "objectType": "rule",
    "ruleType": "Headers",
    "name": "Header de request",
    "status": "Active",
    "groupId": "Group_qa",
    "pairs": [
      {
        "id": "p2",
        "source": {
          "key": "Url",
          "operator": "Contains",
          "value": "/echo",
          "filters": { "requestMethod": ["POST"] }
        },
        "modifications": {
          "Request": [
            { "id": "m1", "header": "X-Nahual-Test", "type": "Add", "value": "from-requestly" }
          ]
        }
      }
    ]
  },
  {
    "id": "Headers_res",
    "objectType": "rule",
    "ruleType": "Headers",
    "name": "Header de response",
    "status": "Inactive",
    "pairs": [
      {
        "id": "p3",
        "source": { "key": "host", "operator": "Equals", "value": "127.0.0.1" },
        "modifications": {
          "Response": [{ "id": "m2", "header": "X-Frame-Options", "type": "Remove" }]
        }
      }
    ]
  },
  {
    "id": "Headers_both",
    "objectType": "rule",
    "ruleType": "Headers",
    "name": "Headers en ambas etapas",
    "status": "Active",
    "pairs": [
      {
        "id": "p4",
        "source": { "key": "path", "operator": "Contains", "value": "/export/" },
        "modifications": {
          "Request": [{ "id": "m3", "header": "X-Trace", "type": "Modify", "value": "on\"*/${x}" }],
          "Response": [{ "id": "m4", "header": "X-Served-By", "type": "Add", "value": "nahual" }]
        }
      }
    ]
  },
  {
