{
  "name": "@nahual/extension",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "verify:dist": "vitest run --config vitest.dist.config.ts",
    "e2e": "playwright test --project=chromium --project=perf",
    "e2e:visual": "playwright test --project=visual",
    "e2e:store": "playwright test --project=store",
    "fixture:serve": "node e2e/fixtures/serve.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@nahual/domain": "workspace:*",
    "@nahual/hook-runtime": "workspace:*",
    "@nahual/protocol": "workspace:*",
    "@tanstack/react-virtual": "3.14.13",
    "immer": "11.1.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sucrase": "3.35.1",
    "typescript": "5.9.3",
    "zod": "4.6.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@crxjs/vite-plugin": "3.0.0",
    "@playwright/test": "1.64.0",
    "@types/chrome": "0.3.4",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
